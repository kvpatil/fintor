# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated state (added at creation time, per house convention)
data/cache/            # SQLite embedding + LLM response caches
data/checkpoints/      # LangGraph SqliteSaver threads
data/market/           # market + news TTL cache
.streamlit/secrets.toml

# Local model weights (downloaded on demand, never committed)
.cache/huggingface/

# NOTE: src/data/kb/index/ IS committed on purpose - it lets graders and
# Cloud Run run the app without re-embedding. See docs/PLAN.md, cost discipline.
