# Secrets
.env
.env.local

# Course material, not our work and not ours to publish. Removed from history
# after it was pushed to a public repo in the initial scaffold.
# Both patterns below were needed: the original was exported as .docx.pdf, but
# a later copy landed as a bare .pdf, which neither pattern matched - so it sat
# untracked-but-committable in a PUBLIC repo until someone ran `git add -A`.
# Match the stem, not one spelling of the extension.
*.docx.pdf
AI Finance Assistant - Problem Statement*.pdf

# Demo video intermediates: the raw webm, the per-beat narration clips, and
# every mux and mix between them - including mux_demo.py's demo_mux.mp4 and
# remix.py's fintor_final_v2.mp4. The finished cut is committed separately as
# docs/demo.mp4, which is a copy of whatever the chain last approved.
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated state, gitignored at creation time per copilot-instructions.md.
# NOTE: gitignore does not support trailing comments on a pattern line - they
# become part of the pattern and silently match nothing. Keep comments above.

# SQLite embedding + LLM response caches
data/cache/
# LangGraph SqliteSaver threads
data/checkpoints/
# market + news TTL cache
data/market/
.streamlit/secrets.toml

# Local model weights, downloaded on demand
.cache/huggingface/

# src/data/kb/index/ IS committed on purpose: it lets graders and Cloud Run run
# the app without re-embedding. See docs/design.md, section 4.

# Coverage artefacts
.coverage
htmlcov/
.DS_Store
