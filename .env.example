# Fintor secrets. Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Nothing outside src/core/config.py reads these.

# --- LLM providers ------------------------------------------------------
# Primary. Required unless running with FINTOR_OFFLINE=1.
OPENAI_API_KEY=

# Fallback in the provider chain. Optional: the chain degrades to a single
# provider if absent, visible in the AI Internals page.
ANTHROPIC_API_KEY=

# --- Cost guard ---------------------------------------------------------
# Hard per-session ceiling in USD. Overrides config.yaml cost.session_budget_usd.
FINTOR_SESSION_BUDGET_USD=0.50

# --- Modes --------------------------------------------------------------
# 1 = deterministic canned responses, zero network, zero spend.
# This is the recommended mode for all UI development.
FINTOR_OFFLINE=0

# --- Observability (optional) -------------------------------------------
# Leave blank and tracing is simply off; the app behaves identically.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Sign-in -------------------------------------------------------------
# REQUIRED to get past the sign-in screen. The six demo accounts (one per
# persona: maya, dev, priya, walter, aisha, sam) share this one password.
#
# Leave it blank and sign-in FAILS CLOSED - the screen says how to configure it
# and accepts nothing, a blank password least of all. That is deliberate: a
# misconfigured door that waves everyone through is worse than no door, because
# it still looks like one.
#
# Stored as a salted scrypt digest in memory, never on disk, never logged.
# Pick your own value; there is no default to discover.
FINTOR_DEMO_PASSWORD=

# --- Optional ------------------------------------------------------------
# Market/news need NO keys (yfinance + RSS are keyless).
# Alpha Vantage is a Phase 2 fallback only; leave blank to skip it entirely.
ALPHAVANTAGE_API_KEY=
